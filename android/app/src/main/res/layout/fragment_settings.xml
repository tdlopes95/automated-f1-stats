<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg">

    <TextView
        android:text="SETTINGS"
        android:textColor="@color/f1_red"
        android:textSize="@dimen/text_small"
        android:letterSpacing="0.1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_lg" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_base_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Backend URL"
        app:boxBackgroundColor="@color/bg_surface"
        app:hintTextColor="@color/text_secondary"
        app:boxStrokeColor="@color/f1_red"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_base_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:inputType="textUri"
            android:singleLine="true" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:text="Include full URL with https:// — no trailing slash needed."
        android:textColor="@color/text_hint"
        android:textSize="@dimen/text_metadata"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save URL"
        android:layout_marginTop="@dimen/spacing_lg"
        style="@style/Widget.Material3.Button"
        android:backgroundTint="@color/f1_red" />

    <!-- ── Home ──────────────────────────────────────────── -->

    <View
        style="@style/Widget.F1.Divider"
        android:layout_marginTop="@dimen/spacing_xl" />

    <LinearLayout
        android:id="@+id/row_customize_home"
        style="@style/Widget.F1.ListRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_tune"
            app:tint="@color/text_secondary"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_md"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/customize_home_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/customize_home_description"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_metadata" />

        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/text_tertiary"
            android:importantForAccessibility="no" />

    </LinearLayout>

    <!-- ── About ─────────────────────────────────────────── -->

    <View
        style="@style/Widget.F1.Divider"
        android:layout_marginTop="@dimen/spacing_xl" />

    <TextView
        android:text="@string/about_title"
        android:textAllCaps="true"
        android:textColor="@color/f1_red"
        android:textSize="@dimen/text_small"
        android:letterSpacing="0.1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg" />

    <TextView
        android:id="@+id/tv_app_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:textAppearance="@style/TextAppearance.F1.Body" />

    <TextView
        style="@style/Widget.F1.SectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/about_credits_title" />

    <TextView
        android:id="@+id/tv_credit_jolpica"
        style="@style/Widget.F1.CreditName"
        android:layout_marginTop="0dp"
        android:text="@string/credit_jolpica_name" />
    <TextView
        style="@style/Widget.F1.CreditDetail"
        android:text="@string/credit_jolpica_detail" />

    <TextView
        android:id="@+id/tv_credit_openf1"
        style="@style/Widget.F1.CreditName"
        android:text="@string/credit_openf1_name" />
    <TextView
        style="@style/Widget.F1.CreditDetail"
        android:text="@string/credit_openf1_detail" />

    <TextView
        android:id="@+id/tv_credit_circuits"
        style="@style/Widget.F1.CreditName"
        android:text="@string/credit_circuits_name" />
    <TextView
        style="@style/Widget.F1.CreditDetail"
        android:text="@string/credit_circuits_detail" />

    <TextView
        android:id="@+id/tv_credit_multiviewer"
        style="@style/Widget.F1.CreditName"
        android:text="@string/credit_multiviewer_name" />
    <TextView
        style="@style/Widget.F1.CreditDetail"
        android:text="@string/credit_multiviewer_detail" />
    <TextView
        style="@style/Widget.F1.CreditDetail"
        android:layout_marginTop="@dimen/spacing_xs"
        android:text="@string/credit_track_maps_detail" />

    <TextView
        android:id="@+id/tv_credit_flagpedia"
        style="@style/Widget.F1.CreditName"
        android:text="@string/credit_flagpedia_name" />
    <TextView
        style="@style/Widget.F1.CreditDetail"
        android:text="@string/credit_flagpedia_detail" />

    <TextView
        android:id="@+id/tv_credit_openmeteo"
        style="@style/Widget.F1.CreditName"
        android:text="@string/credit_openmeteo_name" />
    <TextView
        style="@style/Widget.F1.CreditDetail"
        android:text="@string/credit_openmeteo_detail" />

    <TextView
        android:id="@+id/tv_credit_mpandroidchart"
        style="@style/Widget.F1.CreditName"
        android:text="@string/credit_mpandroidchart_name" />
    <TextView
        style="@style/Widget.F1.CreditDetail"
        android:text="@string/credit_mpandroidchart_detail" />

    <TextView
        style="@style/Widget.F1.CreditDetail"
        android:layout_marginTop="@dimen/spacing_row"
        android:text="@string/credit_news_detail" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="@string/about_disclaimer"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/text_metadata" />

</LinearLayout>

</androidx.core.widget.NestedScrollView>

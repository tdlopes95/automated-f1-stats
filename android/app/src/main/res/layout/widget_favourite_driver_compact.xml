<?xml version="1.0" encoding="utf-8"?>
<!-- 2x1 favourite driver widget: name, position and points. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:paddingStart="@dimen/spacing_row"
    android:paddingEnd="@dimen/spacing_row"
    android:paddingTop="@dimen/spacing_xs"
    android:paddingBottom="@dimen/spacing_xs">

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_team_strip"
            android:layout_width="4dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_team_strip" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_driver_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_favourite_label"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body_sm"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_position_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_metadata" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/widget_prompt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/widget_choose_driver"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_metadata"
        android:visibility="gone" />

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Round detail "Analysis" tab: lap positions, lap times and pit stops. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sv_analysis"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_row"
        android:paddingEnd="@dimen/spacing_row"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_lg">

        <!-- Loading skeleton -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_analysis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View style="@style/Widget.F1.AnalysisChipSkeleton" />
                    <View style="@style/Widget.F1.AnalysisChipSkeleton" />
                    <View style="@style/Widget.F1.AnalysisChipSkeleton" />
                    <View style="@style/Widget.F1.AnalysisChipSkeleton" />
                    <View style="@style/Widget.F1.AnalysisChipSkeleton" />

                </LinearLayout>

                <View
                    android:layout_width="80dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:background="@color/bg_shimmer" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/chart_height_positions"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:background="@color/bg_shimmer" />

                <View
                    android:layout_width="80dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:background="@color/bg_shimmer" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/chart_height_lap_times"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:background="@color/bg_shimmer" />

            </LinearLayout>

        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- Inline error with retry -->
        <LinearLayout
            android:id="@+id/layout_analysis_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="@dimen/spacing_xxl"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_analysis_error"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/analysis_error"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_metadata" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_analysis_retry"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_retry"
                android:textColor="@color/f1_red" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_analysis_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_drivers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:chipSpacingHorizontal="@dimen/spacing_sm" />

            </HorizontalScrollView>

            <TextView
                android:id="@+id/tv_analysis_no_laps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/analysis_no_laps"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_metadata"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layout_analysis_charts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.F1.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/analysis_positions_title" />

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chart_positions"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/chart_height_positions" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/Widget.F1.SectionLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/analysis_lap_times_title" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_hide_slow_laps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/analysis_hide_slow_laps"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_metadata" />

                </LinearLayout>

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chart_lap_times"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/chart_height_lap_times" />

                <TextView
                    android:id="@+id/tv_lap_times_empty"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/chart_height_lap_times"
                    android:gravity="center"
                    android:text="@string/analysis_select_driver"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_metadata"
                    android:visibility="gone" />

            </LinearLayout>

            <TextView
                style="@style/Widget.F1.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/analysis_pit_stops_title" />

            <LinearLayout
                android:id="@+id/ll_analysis_pit_stops"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_analysis_pit_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_metadata" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

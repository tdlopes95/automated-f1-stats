<?xml version="1.0" encoding="utf-8"?>
<!-- Home card: NEXT_RACE (race weekend hero) -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_next_race"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_md"
    android:layout_marginEnd="@dimen/spacing_md"
    android:layout_marginTop="@dimen/spacing_md"
    android:layout_marginBottom="@dimen/spacing_md"
    style="@style/Widget.F1.Card.Hero">

    <LinearLayout
        android:id="@+id/card_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Circuit image with gradient overlay -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/hero_image_height">

            <ImageView
                android:id="@+id/iv_next_race_circuit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:padding="@dimen/spacing_sm"
                android:background="@color/bg_hero_image" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_bottom_dark" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md"
                android:paddingBottom="@dimen/spacing_md">

                <TextView
                    android:text="@string/home_next_race_label"
                    android:textColor="@color/f1_red"
                    android:textSize="@dimen/text_label"
                    android:letterSpacing="0.12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/spacing_xs">

                    <TextView
                        android:id="@+id/tv_next_race_flag"
                        android:textSize="@dimen/text_display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_sm" />

                    <!-- Task 4: Race name at text_display (22sp) for premium feel -->
                    <TextView
                        android:id="@+id/tv_next_race_name"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_display"
                        android:textStyle="bold"
                        android:letterSpacing="-0.01"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:ellipsize="end" />

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

        <!-- Content below image — Task 4: hierarchy is session label → countdown → context -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- 1. NEXT SESSION LABEL — what session is coming up (eyebrow above countdown) -->
            <TextView
                android:id="@+id/tv_next_session"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_label"
                android:letterSpacing="0.1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- 2. COUNTDOWN — dominant visual element (Task 4: 48sp hero, white) -->
            <TextView
                android:id="@+id/tv_countdown"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_hero"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs" />

            <!-- 3. HERO STATE — Weekend Complete / Offseason (Task 2: replaces countdown when state changes) -->
            <LinearLayout
                android:id="@+id/layout_hero_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_hero_state_title"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs" />

                <TextView
                    android:id="@+id/tv_hero_state_subtitle"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_metadata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- 4. RACE DATE — secondary supporting context -->
            <TextView
                android:id="@+id/tv_next_race_date"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_metadata"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs" />

            <!-- 5. CIRCUIT NAME — tertiary context -->
            <TextView
                android:id="@+id/tv_next_race_circuit"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/text_metadata"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />

            <!-- 6. Weekend Timeline (visual session progress dots) -->
            <LinearLayout
                android:id="@+id/ll_weekend_timeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/spacing_md"
                android:visibility="gone" />

            <!-- 7. Session times list -->
            <LinearLayout
                android:id="@+id/ll_session_times"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/spacing_sm" />

        </LinearLayout>

    </LinearLayout>

    <include layout="@layout/view_home_card_status" />

</com.google.android.material.card.MaterialCardView>
